{
  "name": "paperlap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:menu": "node tests/menu-browser.mjs",
    "test:sound": "node tests/sound-browser.mjs",
    "test:handling": "node tests/handling-browser.mjs",
    "test:editor": "node tests/editor-browser.mjs",
    "test:storage": "node tests/storage-browser.mjs",
    "test:trackbook": "node tests/trackbook-browser.mjs",
    "bench:storage": "tsx tests/storage-performance.ts",
    "bench:storage:browser": "node tests/storage-performance-browser.mjs",
    "test:motion": "node tests/motion-browser.mjs",
    "record:motion": "PAPERLAP_RECORD=1 node tests/motion-browser.mjs",
    "test:focus": "node tests/focus-browser.mjs",
    "test:draft": "node tests/draft-browser.mjs && node tests/draft-storage-browser.mjs && node tests/draft-interruption-browser.mjs",
    "test:draft-review": "node tests/draft-storage-browser.mjs && node tests/draft-interruption-browser.mjs",
    "bench:draft:browser": "node tests/draft-performance-browser.mjs",
    "demo:local-edit": "vite --config vite.local-edit.config.ts --host 127.0.0.1 --port 5174 --strictPort",
    "build:local-edit": "npm run typecheck && vite build --config vite.local-edit.config.ts",
    "test:local-edit": "node tests/local-edit-browser.mjs",
    "bench:local-edit": "tsx tests/local-edit-performance.ts",
    "record:local-edit": "PAPERLAP_RECORD=1 node tests/local-edit-browser.mjs",
    "bench:v3:browser": "node tests/save-v3-performance-browser.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
